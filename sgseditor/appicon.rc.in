IDI_APP_ICON ICON DISCARDABLE "@VGS_EDITOR_DIR@/assets/gracia/logo.ico"

// The version comes from sgsversion.h, read by CMakeLists.txt.
1 VERSIONINFO
FILEVERSION @SGS_EDITOR_VERSION_COMMAS@
PRODUCTVERSION @SGS_EDITOR_VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Victor M. Feliz"
            VALUE "FileDescription", "SGS Editor"
            VALUE "FileVersion", "@SGS_EDITOR_VERSION@.0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Victor M. Feliz. All rights reserved."
            VALUE "OriginalFilename", "SGSEditor.exe"
            VALUE "ProductName", "SGS Editor"
            VALUE "ProductVersion", "@SGS_EDITOR_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

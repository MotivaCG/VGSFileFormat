// Exact HDR lerp using fixed-function blending; no SceneColor copy or second splat draw.
#include "/Engine/Public/Platform.ush"
Texture2D<float4> MixReference;
Texture2D<float> MixDepth;
Texture2D<float> SceneDepth;
void MainPS(float4 Position : SV_Position, out float4 Color : SV_Target0)
{
 int3 Pixel = int3(int2(Position.xy), 0);
 Color = MixReference.Load(Pixel);
 // Another renderer or single-layer water may have replaced the surface since our base pass.
 if (Color.a <= 0.0f || MixDepth.Load(Pixel) != SceneDepth.Load(Pixel)) discard;
}

#pragma once

#include "/Plugin/VGS/Shared/VGSSplatDefinitions.h"

struct FShadedVGSSplatData
{
	float4 Position;
	float4 Axes;
	float4 Color;
};

// Mirrors FVGSSplatCluster in VGSSplatCluster.h, keep the two in sync.
struct FVGSSplatCluster
{
	float3 BoundsMin;
	uint   SplatOffset;
	float3 BoundsMax;
	uint   SplatCount;
	uint   Level;
	float  Error;
	uint   ParentIndex;
	uint   Padding;
};

uint VGSSplatPackHalf2(float2 V)
{
	return f32tof16(V.x) | (f32tof16(V.y) << 16);
}

float2 VGSSplatUnpackHalf2(uint Packed)
{
	return float2(f16tof32(Packed & 0xFFFFu), f16tof32(Packed >> 16));
}

// VGS: a unit vector in one word, octahedral, 16 bits a coordinate, over the whole sphere: a
// lit splat's view-space normal keeps its z, sign included (VGSSplatGBuffer.usf averages x, y
// and z, not x and y with z made up).
uint VGSSplatPackOctNormal(float3 N)
{
	N /= max(abs(N.x) + abs(N.y) + abs(N.z), 1e-6f);
	float2 P = N.xy;
	if (N.z < 0.0f)
	{
		P = (1.0f - abs(N.yx)) * select(N.xy >= 0.0f, 1.0f, -1.0f);
	}
	const uint2 Q = uint2(round(saturate(P * 0.5f + 0.5f) * 65535.0f));
	return Q.x | (Q.y << 16);
}

float3 VGSSplatUnpackOctNormal(uint W)
{
	float2 P = float2(W & 65535u, W >> 16) / 65535.0f * 2.0f - 1.0f;
	const float Z = 1.0f - abs(P.x) - abs(P.y);
	if (Z < 0.0f)
	{
		P = (1.0f - abs(P.yx)) * select(P.xy >= 0.0f, 1.0f, -1.0f);
	}
	return normalize(float3(P, Z)); // z < 0 (towards the camera) is the folded half
}

struct FPackedShadedVGSSplatData
{
	float ViewZ;
	uint  NDC;
	uint2 Axes;
	uint2 Color;
};

FPackedShadedVGSSplatData PackShadedVGSSplat(FShadedVGSSplatData In)
{
	const float ViewZ = In.Position.z * PrimaryView.ClipToView[2][2] + In.Position.w * PrimaryView.ClipToView[3][2];

	FPackedShadedVGSSplatData Out;
	// Culled splats use sentinel value: -FLOAT_MAX.
	Out.ViewZ = (In.Position.w > 0.0f) ? ViewZ : -FLOAT_MAX;
	Out.NDC = VGSSplatPackHalf2(In.Position.xy / In.Position.w);
	Out.Axes = uint2(VGSSplatPackHalf2(In.Axes.xy), VGSSplatPackHalf2(In.Axes.zw));
	Out.Color = uint2(VGSSplatPackHalf2(In.Color.rg), VGSSplatPackHalf2(In.Color.ba));
	return Out;
}

FShadedVGSSplatData UnpackShadedVGSSplat(FPackedShadedVGSSplatData In)
{
	FShadedVGSSplatData Out;

	if (In.ViewZ <= 0.0f)
	{
		Out.Position = -FLOAT_MAX;
		Out.Axes = (float4)0;
		Out.Color = (float4)0;
		return Out;
	}

	const float2 NDC = VGSSplatUnpackHalf2(In.NDC);
	const float W = In.ViewZ * PrimaryView.ViewToClip[2][3] + PrimaryView.ViewToClip[3][3];
	const float ClipZ = In.ViewZ * PrimaryView.ViewToClip[2][2] + PrimaryView.ViewToClip[3][2];

	Out.Position = float4(NDC * W, ClipZ, W);
	Out.Axes = float4(VGSSplatUnpackHalf2(In.Axes.x), VGSSplatUnpackHalf2(In.Axes.y));
	Out.Color = float4(VGSSplatUnpackHalf2(In.Color.x), VGSSplatUnpackHalf2(In.Color.y));
	return Out;
}

float VGSSplatFalloff(float r2, float3 FalloffParameters)
{
	return saturate(FalloffParameters.x * exp(-r2) + FalloffParameters.y * r2 + FalloffParameters.z);
}

uint2 ComputeTile2D(float2 ScreenPos, uint2 TileSize)
{
	return ScreenPos / TileSize;
}

uint ComputeTileId(uint2 Tile2D, int2 TileDimension)
{
	return Tile2D.y * TileDimension.x + Tile2D.x;
}

float4 ComputeBBox(float2 P, float2 X, float2 Y)
{
#if 1
	float2 HalfExtent = float2(
		sqrt(X.x * X.x + Y.x * Y.x),
		sqrt(X.y * X.y + Y.y * Y.y)
	);
	return float4(P - HalfExtent, P + HalfExtent);
#else
	float2 P00 = P - Y - X;
	float2 P01 = P - Y + X;
	float2 P10 = P + Y - X;
	float2 P11 = P + X + Y;

	float2 Min = min(min(P00, P01), min(P10, P11));
	float2 Max = max(max(P00, P01), max(P10, P11));
	return float4(Min, Max);
#endif
}

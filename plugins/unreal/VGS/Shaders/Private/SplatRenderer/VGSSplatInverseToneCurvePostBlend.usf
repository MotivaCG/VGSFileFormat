// VGS: a copy of Epic's GaussianSplat renderer (UE 5.9.0, CL 60351404), renamed by plugins/unreal/tools/copy_epic_splat_renderer.py.
// What VGS changed is marked "VGS CHANGE"; see plugins/unreal/EPIC_RENDERER_COPY.md.
// Copyright Epic Games, Inc. All Rights Reserved.

// Fused post-blend inverse tone curve + composite. Applies the inverse curve to the
// splat scratch, then composites onto SceneColor via ROP premultiplied alpha-over.
// Transmittance is carried in .a to match UE SceneColor convention.

#define LUT_SAMPLER_TRILINEAR    0
#define LUT_SAMPLER_TETRAHEDRAL  1
#define LUT_SAMPLER              LUT_SAMPLER_TRILINEAR

#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "/Engine/Private/ColorSpace.ush"

Texture2D    SplatColor_Texture;
SamplerState SplatColor_Sampler;

// Inverse of UE's forward tone curve: samples display-referred linear input in [0,1]
// and returns scene-linear values, so the later tonemap cancels back to the original
// display color.
Texture3D    InverseToneCurveLUT;
SamplerState InverseToneCurveLUTSampler;

FScreenTransform SvPositionToInputTextureUV;

static const float kOpacityEpsilon = 1e-5f;

// 0 = no inversion; 1 = full LUT-sampled inverse.
float Strength;

// Per-axis grid size of the (cubic) LUT.
float InverseToneCurveLUTEdge;

// VGS CHANGE: the capture's intensity, a scale on its linear colour; and whether the
// scratch holds sRGB values (VGSSplatShading.usf, BlendInSRGB) or Epic's linear ones.
float Intensity;
uint BlendInSRGB;

// VGS CHANGE: a grade on the capture's display colour, sRGB values in [0, 1]: x = gamma
// (above 1 brightens the midtones), y = contrast about 0.5, z = saturation; then Tint
// multiplies the values (the tint colour as sRGB values). GradeActive is 0 when both are
// (1, 1, 1), and then the colour is not touched at all.
float3 Grade;
float3 Tint;
uint GradeActive;

float3 VGSSRGBToLinear(float3 C)
{
	return select(C > 0.04045f, pow(C * (1.0f / 1.055f) + 0.0521327f, 2.4f), C * (1.0f / 12.92f));
}

float3 VGSLinearToSRGB(float3 C)
{
	return select(C > 0.0031308f, 1.055f * pow(C, 1.0f / 2.4f) - 0.055f, C * 12.92f);
}

// The colour of a pixel the splats barely cover is the scratch divided by a tiny opacity,
// so it is unreliable; the grade fades out below 5 % opacity to keep it off the capture's
// outline. What such a pixel adds to the image is small either way.
float3 VGSApplyGrade(float3 ColorSRGB, float Opacity)
{
	float3 C = (ColorSRGB - 0.5f) * Grade.y + 0.5f;
	C = pow(saturate(C), 1.0f / max(Grade.x, 1e-3f));
	const float Luma = dot(C, float3(0.2126f, 0.7152f, 0.0722f));
	C = saturate(lerp(Luma.xxx, C, Grade.z) * Tint);
	return lerp(ColorSRGB, C, smoothstep(0.0f, 0.05f, Opacity));
}

// Working color space -> sRGB linear. The LUT is baked against sRGB primaries (D65),
// so non-sRGB projects must transform before sampling. The reverse transform ships
// as SRGBColorToWorkingColorSpace in ColorSpace.ush.
float3 WorkingColorSpaceColorToSRGB(float3 ColorWCS)
{
#if WORKING_COLOR_SPACE_IS_SRGB
	return ColorWCS;
#else
	return mul(XYZ_2_Linear_sRGB_MAT, LinearRGB_2_XYZ(ColorWCS));
#endif
}

// Trilinear: hardware sampler with center-of-texel UVW remap.
float3 SampleLUT_Trilinear(float3 ColorClamped, float Edge)
{
	const float3 UVW = ColorClamped * ((Edge - 1.0f) / Edge)
	                 + (0.5f / Edge);
	return InverseToneCurveLUT.SampleLevel(InverseToneCurveLUTSampler, UVW, 0).rgb;
}

// Tetrahedral 6-tet barycentric. Each branch picks the tet containing
// (d.r, d.g, d.b) by ordering and fetches the 2 unique intermediate corners.
// c0 and c7 are shared across all tets.
float3 SampleLUT_Tetrahedral(float3 ColorClamped, float Edge)
{
	const int N = (int)Edge;
	const float3 GridPos = ColorClamped * (Edge - 1.0f);
	const int3 B = clamp(int3(floor(GridPos)), int3(0, 0, 0), int3(N - 2, N - 2, N - 2));
	const float3 d = saturate(GridPos - B);

	const float3 c0 = InverseToneCurveLUT.Load(int4(B, 0)).rgb;
	const float3 c7 = InverseToneCurveLUT.Load(int4(B + int3(1, 1, 1), 0)).rgb;

	if (d.x > d.y)
	{
		if (d.y > d.z)
		{
			// r > g > b
			const float3 c1 = InverseToneCurveLUT.Load(int4(B + int3(1, 0, 0), 0)).rgb;
			const float3 c3 = InverseToneCurveLUT.Load(int4(B + int3(1, 1, 0), 0)).rgb;
			return c0 + d.x * (c1 - c0) + d.y * (c3 - c1) + d.z * (c7 - c3);
		}
		else if (d.x > d.z)
		{
			// r > b >= g
			const float3 c1 = InverseToneCurveLUT.Load(int4(B + int3(1, 0, 0), 0)).rgb;
			const float3 c5 = InverseToneCurveLUT.Load(int4(B + int3(1, 0, 1), 0)).rgb;
			return c0 + d.x * (c1 - c0) + d.z * (c5 - c1) + d.y * (c7 - c5);
		}
		else
		{
			// b >= r > g
			const float3 c4 = InverseToneCurveLUT.Load(int4(B + int3(0, 0, 1), 0)).rgb;
			const float3 c5 = InverseToneCurveLUT.Load(int4(B + int3(1, 0, 1), 0)).rgb;
			return c0 + d.z * (c4 - c0) + d.x * (c5 - c4) + d.y * (c7 - c5);
		}
	}
	else
	{
		if (d.z > d.y)
		{
			// b > g >= r
			const float3 c4 = InverseToneCurveLUT.Load(int4(B + int3(0, 0, 1), 0)).rgb;
			const float3 c6 = InverseToneCurveLUT.Load(int4(B + int3(0, 1, 1), 0)).rgb;
			return c0 + d.z * (c4 - c0) + d.y * (c6 - c4) + d.x * (c7 - c6);
		}
		else if (d.z > d.x)
		{
			// g >= b > r
			const float3 c2 = InverseToneCurveLUT.Load(int4(B + int3(0, 1, 0), 0)).rgb;
			const float3 c6 = InverseToneCurveLUT.Load(int4(B + int3(0, 1, 1), 0)).rgb;
			return c0 + d.y * (c2 - c0) + d.z * (c6 - c2) + d.x * (c7 - c6);
		}
		else
		{
			// g >= r >= b
			const float3 c2 = InverseToneCurveLUT.Load(int4(B + int3(0, 1, 0), 0)).rgb;
			const float3 c3 = InverseToneCurveLUT.Load(int4(B + int3(1, 1, 0), 0)).rgb;
			return c0 + d.y * (c2 - c0) + d.x * (c3 - c2) + d.z * (c7 - c3);
		}
	}
}

float3 SampleInverseToneCurveLUT(float3 ColorClamped, float Edge)
{
#if LUT_SAMPLER == LUT_SAMPLER_TETRAHEDRAL
	return SampleLUT_Tetrahedral(ColorClamped, Edge);
#else
	return SampleLUT_Trilinear(ColorClamped, Edge);
#endif
}

#ifndef APPLY_INVERSE_TONE_CURVE
#define APPLY_INVERSE_TONE_CURVE 1
#endif // APPLY_INVERSE_TONE_CURVE

void MainPS(
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const float2 TextureUV = ApplyScreenTransform(SvPosition.xy, SvPositionToInputTextureUV);
	const float4 Splat     = SplatColor_Texture.SampleLevel(SplatColor_Sampler, TextureUV, 0);

	// Scratch RT stores transmittance in .a to match UE SceneColor convention.
	const float Transmittance = Splat.a;
	const float Opacity       = 1.0f - Transmittance;

	if (Opacity < kOpacityEpsilon)
	{
		// Fully transparent splat pixel: skip the ROP write entirely.
		discard;
		return;
	}

	// VGS CHANGE: the scratch holds the splats blended in sRGB values, premultiplied, with
	// no pre-exposure (VGSSplatShading.usf, VGSSplatHardwareRasterize.usf). Unpremultiply to
	// the sRGB colour of the splat layer, make it linear, then as Epic: the inverse tone
	// curve, the working colour space; then the capture's intensity, pre-exposure, and
	// premultiply again for the composite. Epic avoids unpremultiplying because of artefacts
	// in faint gradients; making the blend linear needs it, so faint pixels are guarded.
	float3 Blended;
	if (BlendInSRGB != 0u)
	{
		float3 ColorSRGB = saturate(Splat.rgb / max(Opacity, 1e-3f));
		if (GradeActive != 0u)
		{
			ColorSRGB = VGSApplyGrade(ColorSRGB, Opacity);
		}
		const float3 LinearSRGB   = VGSSRGBToLinear(ColorSRGB);
#if APPLY_INVERSE_TONE_CURVE
		const float3 InversedSRGB = SampleInverseToneCurveLUT(LinearSRGB, InverseToneCurveLUTEdge);
		Blended = SRGBColorToWorkingColorSpace(lerp(LinearSRGB, InversedSRGB, Strength)) * Opacity;
#else
		Blended = SRGBColorToWorkingColorSpace(LinearSRGB) * Opacity;
#endif
	}
	else
	{
		// Epic's, premultiplied as it comes (pre-exposure is no longer in the scratch).
		float3 Color = Splat.rgb;
		if (GradeActive != 0u)
		{
			// The grade works on display values: unpremultiply, to sRGB values, grade, back.
			const float SafeOpacity = max(Opacity, 1e-3f);
			const float3 ColorSRGB = VGSLinearToSRGB(saturate(WorkingColorSpaceColorToSRGB(Color / SafeOpacity)));
			Color = SRGBColorToWorkingColorSpace(VGSSRGBToLinear(VGSApplyGrade(ColorSRGB, Opacity))) * SafeOpacity;
		}
#if APPLY_INVERSE_TONE_CURVE
		const float3 InversedSRGB = SampleInverseToneCurveLUT(saturate(WorkingColorSpaceColorToSRGB(Color)), InverseToneCurveLUTEdge);
		Blended = lerp(Color, SRGBColorToWorkingColorSpace(InversedSRGB), Strength);
#else
		Blended = Color;
#endif
	}

	// Output alpha stays as transmittance for the ROP blend (One, SrcAlpha) /
	// (Zero, SrcAlpha) so transmittances multiply correctly into SceneColor.
	OutColor = float4(Blended * (Intensity * View.PreExposure), Transmittance);
}

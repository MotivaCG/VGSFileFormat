#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/ComputeShaderUtils.ush"

Buffer<uint> ClusterCountBuffer;
uint2 DimensionLimit;

RWBuffer<uint> RWShadeIndirectArgs;

[numthreads(1, 1, 1)]

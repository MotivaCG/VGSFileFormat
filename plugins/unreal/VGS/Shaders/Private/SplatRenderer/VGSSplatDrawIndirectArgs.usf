#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/ComputeShaderUtils.ush"
#include "/Engine/Private/GPUMessaging.ush"

Buffer<uint> SplatCountBuffer;
RWBuffer<uint> RWDrawIndirectArgs;

uint StatsMessageId;
uint StatsFrameNumber;
uint StatsNumClustersSubmitted;
uint StatsNumSplatsSubmitted;
uint StatsHasClusterCount;
Buffer<uint> StatsClusterCountBuffer;

// Triangle strip with 2 triangles per splat
#define SPLAT_VERTICES_PER_INSTANCE 4U

[numthreads(1, 1, 1)]
void MainCS()
{
	const uint SplatCount = SplatCountBuffer[0];
	WriteIndirectDrawArgs(RWDrawIndirectArgs, 0, SPLAT_VERTICES_PER_INSTANCE, SplatCount, 0U, 0U);

	// Layout must match VGSSplat::FRenderStats::HandleMessage
	FGPUMessageWriter Mw = GPUMessageBegin(StatsMessageId, 5U);
	GPUMessageWriteItem(Mw, StatsFrameNumber);
	GPUMessageWriteItem(Mw, StatsNumClustersSubmitted);
	GPUMessageWriteItem(Mw, StatsHasClusterCount != 0u ? StatsClusterCountBuffer[0] : 0u);
	GPUMessageWriteItem(Mw, StatsNumSplatsSubmitted);
	GPUMessageWriteItem(Mw, SplatCount);
}

diff -ruN a/VGS/Source/VGSSplatRenderer/Internal/VGSSplatLightShadow.h b/VGS/Source/VGSSplatRenderer/Internal/VGSSplatLightShadow.h
--- a/VGS/Source/VGSSplatRenderer/Internal/VGSSplatLightShadow.h	1970-01-01 01:00:00.000000000 +0100
+++ b/VGS/Source/VGSSplatRenderer/Internal/VGSSplatLightShadow.h	2026-11-12 18:09:33.311033000 +0100
@@ -0,0 +1,35 @@
+// VGS: not Epic's. The splat renderer's own shadow of the scene's directional light.
+#pragma once
+
+#include "CoreMinimal.h"
+#include "RenderGraphFwd.h"
+
+class FLightSceneInfo;
+class FScene;
+class FSceneView;
+class FVGSSplatRenderProxy;
+struct FPostProcessingInputs;
+
+namespace VGSSplat
+{
+	/**
+	 * The light the splats' own shadow map is drawn from: of the scene's directional lights
+	 * that cast dynamic shadows, the atmosphere's sun (Atmosphere Sun Light, index 0) if one
+	 * is, otherwise the brightest; null if none casts shadows.
+	 */
+	const FLightSceneInfo* FindMainLight(const FScene& Scene);
+
+	/** The way the main light goes (unit). */
+	FVector GetMainLightDirection(const FLightSceneInfo& Light);
+
+	/**
+	 * With r.VGSSplat.Shadow.Method 0 or 1: draws the casting proxies (bCastShadow) from the
+	 * main directional light (FindMainLight) into a shadow map of their own, as Gaussians with
+	 * their real opacity,
+	 * and takes that light's direct contribution off the lit scene behind them
+	 * (Shaders/Private/SplatRenderer/VGSSplatLightShadow.usf). Before post-processing, so the
+	 * captures that are not lit (composited later) are never darkened; lit ones only with
+	 * r.VGSSplat.Shadow.Self 1.
+	 */
+	void RenderLightShadow(FRDGBuilder& GraphBuilder, const FSceneView& View, const FPostProcessingInputs& Inputs, TConstArrayView<const FVGSSplatRenderProxy*> Proxies);
+}
diff -ruN a/VGS/Source/VGSSplatRenderer/Internal/VGSSplatRenderPipeline.h b/VGS/Source/VGSSplatRenderer/Internal/VGSSplatRenderPipeline.h
--- a/VGS/Source/VGSSplatRenderer/Internal/VGSSplatRenderPipeline.h	2026-11-11 13:56:29.481777600 +0100
+++ b/VGS/Source/VGSSplatRenderer/Internal/VGSSplatRenderPipeline.h	2026-11-12 18:09:33.312581400 +0100
@@ -54,8 +54,40 @@
 	float OpacityScale = 1.0f;
 
 	bool bVisible = true;
+	// VGS CHANGE: a scale on the splats' linear colour, applied when they are composited
+	// (VGSSplatInverseToneCurvePostBlend.usf). VGS's Intensity (EV) is 2^EV.
+	float Intensity = 1.0f;
+	// VGS CHANGE: blend splats in sRGB values, as most captures are trained and as the VGS
+	// viewer draws them, rather than in linear light as Epic's renderer does.
+	bool bBlendInSRGB = true;
+	// VGS CHANGE: a grade on the capture's display colour (its sRGB values), applied when
+	// it is composited: gamma, contrast about 0.5 and saturation, then a tint that multiplies
+	// those values. (1, 1, 1) leaves it alone.
+	FVector3f Grade = FVector3f(1.0f, 1.0f, 1.0f);

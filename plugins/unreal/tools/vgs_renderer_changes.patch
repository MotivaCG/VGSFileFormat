+		bool ReadLUT(const FString& Path, uint32& OutEdge, TArray<uint16>& OutRGBA)
+		{
+			TArray<uint8> File;
+			if (!FFileHelper::LoadFileToArray(File, *Path, FILEREAD_Silent) || File.Num() < 16 || FMemory::Memcmp(File.GetData(), "VLUT", 4) != 0)

@@ -70,6 +70,7 @@
 
 // Spherical harmonics
 uint SHCoordinateSpace;
+uint BlendInSRGB; // VGS CHANGE: see CalculateColor
 
 // Per-component overrides
 float PointScaleFactor;
@@ -309,12 +310,27 @@
 	}
 #endif // SH_DEGREE >= 1
 
-	// Clamp to minimum positive denormal
-	Color = max(Color + 0.5f, 6.10352e-5);
-	// Convert sRGB -> Linear
-	Color = select(Color > 0.04045f, pow(Color * (1.0f / 1.055f) + 0.0521327f, 2.4f), Color * (1.0f / 12.92f));
-	// Ensure that imported colors are brought to the working color space gamut
-	Color = SRGBColorToWorkingColorSpace(Color);
+	// VGS CHANGE: Epic makes each splat's colour linear here and blends in linear light,
+	// which BlendInSRGB 0 still does.
+	// Captures are trained blending sRGB values, and the VGS viewer draws them that way, so
+	// the colour stays sRGB, clamped to [0, 1] as the viewer clamps it, and the blended
+	// result is made linear in VGSSplatInverseToneCurvePostBlend.usf. Blending in linear
+	// light makes faint splats show far more than they were trained to (a 20 % splat over
+	// black gives 48 % of its colour instead of 20 %): coloured haze around hair and edges.
+	if (BlendInSRGB != 0u)
+	{
+		Color = saturate(Color + 0.5f);
+	}
+	else
+	{
+		// Epic's, for captures trained blending in linear light.
+		// Clamp to minimum positive denormal
+		Color = max(Color + 0.5f, 6.10352e-5);
+		// Convert sRGB -> Linear
+		Color = select(Color > 0.04045f, pow(Color * (1.0f / 1.055f) + 0.0521327f, 2.4f), Color * (1.0f / 12.92f));
+		// Ensure that imported colors are brought to the working color space gamut
+		Color = SRGBColorToWorkingColorSpace(Color);
+	}
 
 	return Color;
 }

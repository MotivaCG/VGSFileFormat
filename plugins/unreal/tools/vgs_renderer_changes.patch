+	Params->LightToUV = FVector4f(float(0.5 / Half), float(-0.5 / Half), 0.5f, 0.5f);
+	Params->MapSize = float(Size);
+	Params->Bias = float(FMath::Max(double(CVarVGSSplatShadowBias.GetValueOnRenderThread()), 2.0 * Texel));

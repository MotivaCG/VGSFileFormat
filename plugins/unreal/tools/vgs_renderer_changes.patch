+		// Epic's, for captures trained blending in linear light.
+		// Clamp to minimum positive denormal
+		Color = max(Color + 0.5f, 6.10352e-5);
+		// Convert sRGB -> Linear
+		Color = select(Color > 0.04045f, pow(Color * (1.0f / 1.055f) + 0.0521327f, 2.4f), Color * (1.0f / 12.92f));
+		// Ensure that imported colors are brought to the working color space gamut
+		Color = SRGBColorToWorkingColorSpace(Color);
+	}
 
 	return Color;
 }

+			TArray<uint16> RGB;
+			RGB.SetNumUninitialized(int32(Texels * 3));
+			if (!FCompression::UncompressMemory(NAME_Zlib, RGB.GetData(), int32(Unpacked), File.GetData() + 16, File.Num() - 16))

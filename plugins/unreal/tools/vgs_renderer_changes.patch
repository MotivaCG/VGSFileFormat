+// towards the camera as the shortest axis is.
+uint Lit;
+uint HasNormals;
+StructuredBuffer<uint> NormalBuffer;
+RWStructuredBuffer<uint> RWShadedNormalBuffer;
+ByteAddressBuffer PreviousSplats;
+float4x4 PreviousLocalToWorld;
+uint MotionHistoryValid;
+RWStructuredBuffer<float2> RWShadedMotionBuffer;
+
+float2 VGSSplatObjectMotion(uint Index, float3 Position)
+{
+	if (MotionHistoryValid == 0u) return 0;
+	const uint Offset = Index * BufferStride;
+	float3 PreviousPosition;
+	if (MotionHistoryValid == 2u) PreviousPosition = Position; // actor motion only, without record correspondence
+	else if (BufferFormat == 0)
+	{
+		// A record that has just been born has no previous visible position.
+		if (asfloat(PreviousSplats.Load(Offset + 52u)) < OpacityThreshold) return 0;
+		PreviousPosition = asfloat(PreviousSplats.Load3(Offset));
+	}
+	else
+	{
+		const uint2 P = PreviousSplats.Load2(Offset);
+		const uint Mask = (1u << 21) - 1u;
+		PreviousPosition = float3((P.y >> 10) & Mask, ((P.x >> 21) | (P.y << 11)) & Mask, P.x & Mask) * PositionScale + PositionBias;
+	}
+	const float3 CurrentWorld = mul(float4(Position, 1), LocalToWorld).xyz;
+	const float3 PreviousWorld = mul(float4(PreviousPosition, 1), PreviousLocalToWorld).xyz;
+	const float4 A = mul(float4(DFAddDemote(PrimaryView.PrevPreViewTranslation, CurrentWorld), 1), PrimaryView.PrevTranslatedWorldToClip);
+	const float4 B = mul(float4(DFAddDemote(PrimaryView.PrevPreViewTranslation, PreviousWorld), 1), PrimaryView.PrevTranslatedWorldToClip);
+	return A.w > 0.0f && B.w > 0.0f ? A.xy / A.w - B.xy / B.w : 0;
+}
+
+float3 VGSUnpackNormal(uint W)
+{
+	float2 P = (float2(W & 65535u, W >> 16) - 1.0f) / 65534.0f * 2.0f - 1.0f;
+	const float Z = 1.0f - abs(P.x) - abs(P.y);
+	if (Z < 0.0f)
+	{
+		P = (1.0f - abs(P.yx)) * select(P.xy >= 0.0f, 1.0f, -1.0f);
+	}
+	return normalize(float3(P, Z));
+}

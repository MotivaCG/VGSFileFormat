diff -ruN a/VGS/Shaders/Private/SplatRenderer/VGSSplatLightShadow.usf b/VGS/Shaders/Private/SplatRenderer/VGSSplatLightShadow.usf
--- /dev/null
+++ b/VGS/Shaders/Private/SplatRenderer/VGSSplatLightShadow.usf
@@ -0,0 +1,142 @@
+// VGS: optical depth in 64 light-space bins, followed by a prefix scan. The
+// resulting transmittance is sampled at the receiver depth by a UE Light Function.
+#include "/Engine/Private/Common.ush"
+
+#if VGS_DEEP_SHADOW_MAP
+ByteAddressBuffer Splats;
+float4x4 LocalToLight;
+float3 PositionScale;
+uint NumSplats;
+float3 PositionBias;
+uint Stride;
+float3 ScaleScale;
+uint BufferFormat;
+float3 ScaleBias;
+float PointScale;
+float2 OpacityQuantization;
+float OpacityScale;
+float3 GridExtent;
+float GridResolution;
+float Dilation;
+float OpticalDepthScale;
+RWStructuredBuffer<uint> OpticalDepth;
+RWStructuredBuffer<uint> NearestDepth;
+// One row of the rotation matrix of a unit quaternion (x, y, z, w), as QuaternionToFloat3x3.
+float3 VGSLightAxis(float4 Q, uint Axis)
+{
+	const float x2 = Q.x + Q.x, y2 = Q.y + Q.y, z2 = Q.z + Q.z;
+	const float xx = Q.x * x2, xy = Q.x * y2, xz = Q.x * z2;
+	const float yy = Q.y * y2, yz = Q.y * z2, zz = Q.z * z2;
+	const float wx = Q.w * x2, wy = Q.w * y2, wz = Q.w * z2;
+	if (Axis == 0u)
+	{
+		return float3(1.0f - (yy + zz), xy + wz, xz - wy);
+	}
+	if (Axis == 1u)
+	{
+		return float3(xy - wz, 1.0f - (xx + zz), yz + wx);
+	}
+	return float3(xz + wy, yz - wx, 1.0f - (xx + yy));
+}
+
+// The renderer's records (VGSSplatShared.h): the float layout, or Epic's quantized one.
+void VGSLightLoadSplat(uint Splat, out float3 Position, out float3 Scale, out float4 Rotation, out float Opacity)
+{
+	const uint Offset = Splat * Stride;
+	if (BufferFormat == 0u)
+	{
+		Position = asfloat(Splats.Load3(Offset));
+		Scale = asfloat(Splats.Load3(Offset + 12u));
+		Rotation = asfloat(Splats.Load4(Offset + 24u));
+		Opacity = asfloat(Splats.Load(Offset + 52u));
+	}
+	else
+	{
+		const uint4 Packed = Splats.Load4(Offset);
+		const uint PackedColor = Splats.Load(Offset + 16u);
+		const uint Mask21 = (1u << 21) - 1u;
+		const uint Mask11 = (1u << 11) - 1u;
+		const uint Mask10 = (1u << 10) - 1u;
+		const float3 P = float3(float((Packed.y >> 10) & Mask21), float(((Packed.x >> 21) | (Packed.y << 11)) & Mask21), float(Packed.x & Mask21));
+		Position = P * PositionScale + PositionBias;
+		const float3 S = float3(float(Packed.z >> 21), float((Packed.z >> 10) & Mask11), float(Packed.z & Mask10));
+		Scale = exp(S * ScaleScale + ScaleBias);
+		Rotation.x = float(Packed.w >> 21) * (2.0f / 2047.0f) - 1.0f;
+		Rotation.y = float((Packed.w >> 10) & Mask11) * (2.0f / 2047.0f) - 1.0f;
+		Rotation.z = float(Packed.w & Mask10) * (2.0f / 1023.0f) - 1.0f;
+		Rotation.w = sqrt(max(1.0f - dot(Rotation.xyz, Rotation.xyz), 0.0f));
+		Opacity = float(PackedColor & 0xffu) * OpacityQuantization.x + OpacityQuantization.y;
+	}
+}
+
+void MainVS(uint VertexId : SV_VertexID, out float4 Position : SV_Position,
+	out float2 OutQ : TEXCOORD0, out float OutDepth : TEXCOORD1, out nointerpolation float OutOpacity : TEXCOORD2)
+{
+	Position = float4(2, 2, 0.5, 1); OutQ = 0; OutDepth = 0; OutOpacity = 0;
+	const uint Splat = VertexId / 6u;
+	if (Splat >= NumSplats) return;
+	float3 Centre, Scale; float4 Rotation; float Opacity;
+	VGSLightLoadSplat(Splat, Centre, Scale, Rotation, Opacity);
+	Opacity = saturate(Opacity * OpacityScale);
+	if (Opacity < 2.0f / 255.0f) return;
+	Centre = mul(float4(Centre, 1), LocalToLight).xyz;
+	const float4 Q = normalize(Rotation);
+	const float3 B0 = mul(VGSLightAxis(Q, 0u) * Scale.x * PointScale, (float3x3)LocalToLight);
+	const float3 B1 = mul(VGSLightAxis(Q, 1u) * Scale.y * PointScale, (float3x3)LocalToLight);
+	const float3 B2 = mul(VGSLightAxis(Q, 2u) * Scale.z * PointScale, (float3x3)LocalToLight);
+	const float A = B0.x * B0.x + B1.x * B1.x + B2.x * B2.x + Dilation;
+	const float B = B0.x * B0.y + B1.x * B1.y + B2.x * B2.y;
+	const float C = B0.y * B0.y + B1.y * B1.y + B2.y * B2.y + Dilation;
+	const float Mid = 0.5f * (A + C);
+	const float Radius = sqrt(max(0.25f * (A - C) * (A - C) + B * B, 0.0f));
+	const float L1 = Mid + Radius, L2 = max(Mid - Radius, 1e-12f);
+	const float2 E1 = abs(B) > 1e-12f ? normalize(float2(B, L1 - A)) : (A >= C ? float2(1, 0) : float2(0, 1));
+	const float2 E2 = float2(-E1.y, E1.x);
+	const float Reach = sqrt(2.0f * log(Opacity * 255.0f));
+	const float2 Corners[6] = {float2(-1,-1),float2(1,-1),float2(1,1),float2(-1,-1),float2(1,1),float2(-1,1)};
+	OutQ = Corners[VertexId % 6u] * Reach;
+	const float2 Offset = OutQ.x * sqrt(L1) * E1 + OutQ.y * sqrt(L2) * E2;
+	Position = float4((Centre.xy + Offset) / GridExtent.xy, 0.5, 1);
+	// Conditional centre along the ray: oblique flat splats change depth across their footprint.
+	const float2 CovZ = float2(B0.z * B0.x + B1.z * B1.x + B2.z * B2.x, B0.z * B0.y + B1.z * B1.y + B2.z * B2.y);
+	const float2 Slope = mul(CovZ, float2x2(C, -B, -B, A)) / max(A * C - B * B, 1e-12f);
+	OutDepth = Centre.z + dot(Slope, Offset);
+	OutOpacity = Opacity;
+}
+
+void MainPS(float4 Position : SV_Position, float2 Q : TEXCOORD0, float Depth : TEXCOORD1,
+	nointerpolation float Opacity : TEXCOORD2, out float Unused : SV_Target0)
+{
+	Unused = 0;
+	const float Alpha = min(Opacity * exp(-0.5f * dot(Q, Q)), 0.995f);
+	if (Alpha < 1.0f / 255.0f) discard;
+	const float NormalizedDepth = saturate((Depth / GridExtent.z + 1.0f) * 0.5f);
+	const uint Layer = min(uint(NormalizedDepth * 64.0f), 63u);
+	InterlockedMin(NearestDepth[uint(Position.y) * uint(GridResolution) + uint(Position.x)], asuint(NormalizedDepth));
+	const uint Index = (Layer * uint(GridResolution) + uint(Position.y)) * uint(GridResolution) + uint(Position.x);
+	const uint Tau = uint(round(-log(1.0f - Alpha) * OpticalDepthScale));
+	InterlockedAdd(OpticalDepth[Index], Tau);
+}
+#endif
+
+#if VGS_DEEP_SHADOW_PREFIX
+StructuredBuffer<uint> OpticalDepth;
+StructuredBuffer<uint> NearestDepth;
+RWTexture2D<float> ShadowAtlas;
+uint Resolution;
+float InverseOpticalDepthScale;
+[numthreads(8,8,1)]
+void PrefixCS(uint3 Id : SV_DispatchThreadID)
+{
+	if (any(Id.xy >= Resolution)) return;
+	// One extra tile protects front-facing receivers from interpolation in front of
+	// the first actual caster, without dropping valid faint layers or back receivers.
+	ShadowAtlas[uint2(0, 8) * Resolution + Id.xy] = min(asfloat(NearestDepth[Id.y * Resolution + Id.x]), 1.0f);
+	float Sum = 0;
+	for (uint Layer = 0; Layer < 64u; ++Layer)
+	{
+		Sum += float(OpticalDepth[(Layer * Resolution + Id.y) * Resolution + Id.x]) * InverseOpticalDepthScale;
+		ShadowAtlas[uint2(Layer % 8u, Layer / 8u) * Resolution + Id.xy] = exp(-min(Sum, 80.0f));
+	}
+}
+#endif
diff -ruN a/VGS/Shaders/Private/SplatRenderer/VGSSplatMotionDebug.usf b/VGS/Shaders/Private/SplatRenderer/VGSSplatMotionDebug.usf
--- /dev/null
+++ b/VGS/Shaders/Private/SplatRenderer/VGSSplatMotionDebug.usf
@@ -0,0 +1,21 @@
+// Development-only readback: verifies the velocity UE consumes after opaque passes.
+#include "/Engine/Private/Common.ush"
+Texture2D<float4> VelocityTexture;
+Texture2D<float> ReceiverMask;
+RWStructuredBuffer<uint> MotionStats;
+int2 ViewMin;
+int2 ViewSize;
+[numthreads(8,8,1)]
+void MainCS(uint3 Id : SV_DispatchThreadID)
+{
+	if (any(Id.xy >= uint2(ViewSize))) return;
+	const int2 Pixel = int2(Id.xy) + ViewMin;
+	if (ReceiverMask.Load(int3(Pixel, 0)) < 0.5f) return;
+	InterlockedAdd(MotionStats[0], 1u);
+	const float4 Raw = VelocityTexture.Load(int3(Pixel, 0));
+	if (all(Raw.xy == 0.0f)) { InterlockedAdd(MotionStats[3], 1u); return; }
+	const float2 V = DecodeVelocityFromTexture((ENCODED_VELOCITY_TYPE)Raw).xy;
+	const float Pixels = length(V * float2(ViewSize) * 0.5f);
+	if (Pixels > 0.05f) InterlockedAdd(MotionStats[1], 1u);
+	InterlockedMax(MotionStats[2], uint(min(Pixels * 1000.0f, 100000000.0f)));
+}
diff -ruN a/VGS/Shaders/Private/SplatRenderer/VGSSplatShading.usf b/VGS/Shaders/Private/SplatRenderer/VGSSplatShading.usf

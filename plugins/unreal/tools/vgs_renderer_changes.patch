@@ -0,0 +1,102 @@
+// VGS: not Epic's. The project's settings for the splat renderer (Project Settings > Plugins),
+// written to the console variables the renderer reads.
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Engine/DeveloperSettings.h"
+#include "VGSSplatSettings.generated.h"
+
+/**
+ * How splats cast shadows (r.VGSSplat.Shadow.Method, the same numbers). Every light lights a
+ * Shaded actor whichever this is, and every mesh's shadow falls on it; this is only about the
+ * shadows the splats cast.
+ */
+UENUM()
+enum class EVGSSplatShadowMethod : uint8
+{
+	/**
+	 * Recommended. The splats cast shadows from the main directional light only (the sun: the
+	 * one marked Atmosphere Sun Light, otherwise the brightest that casts shadows). They are
+	 * drawn from it into a shadow map of their own, as soft Gaussians with their real opacity,
+	 * and cumulative transmittance is sampled at the receiver's depth by a Light Function
+	 * before UE evaluates the sun. Spot, point and rect lights use method Mixed for shadows.
+	 * Existing user light functions use native casters as fallback.
+	 */
+	SplatShadowMap = 0 UMETA(DisplayName = "Splat Shadow Map (sun only)"),
+
+	/**
+	 * The sun as Splat Shadow Map (clean shadows), and every other light that casts shadows
+	 * (spot, point, rect, other directional lights) as Unreal Shadow Maps (grainy shadows). The
+	 * cost of both representations depends on the grid, splat count and other lights.
+	 */
+	Mixed = 1 UMETA(DisplayName = "Splat Shadow Map (sun) + Unreal Shadow Maps (other lights)"),
+
+	/**
+	 * The splats go into Unreal's own shadow maps (virtual or cascaded) as small opaque shapes,
+	 * each at a random opacity: shadows from every light that casts them, the sun included, but
+	 * grainy and frayed, and Shaded characters shadow themselves in blotches (each actor's
+	 * Shadow Inset reduces them). About 0.4 ms for 300,000 splats per light.
+	 */
+	UnrealShadowMaps = 2 UMETA(DisplayName = "Unreal Shadow Maps (all lights)"),
+
+	/** The splats cast no shadows at all, whatever each actor's Cast Shadow says. Costs nothing. */
+	None = 3 UMETA(DisplayName = "No Shadows"),
+};
+
+UCLASS(config = Engine, defaultconfig)
+class UVGSSplatSettings : public UDeveloperSettings
+{
+	GENERATED_BODY()
+
+public:
+	/** How splats cast shadows, for every actor of the plugin in the project. */
+	UPROPERTY(config, EditAnywhere, Category = "Shadows")
+	EVGSSplatShadowMethod ShadowMethod = EVGSSplatShadowMethod::SplatShadowMap;
+
+	/**
+	 * In the sun's shadow from the splats' own shadow map, Shaded actors also shadow themselves:
+	 * an arm on the body, one person on another. Off excludes visible Shaded pixels of this
+	 * renderer; ordinary UE receivers still get depth-resolved shadows. Self-illuminated actors
+	 * are composited later and do not receive this lighting.
+	 */
+	UPROPERTY(config, EditAnywhere, Category = "Shadows",
+		meta = (DisplayName = "Self Shadowing", EditCondition = "ShadowMethod == EVGSSplatShadowMethod::SplatShadowMap || ShadowMethod == EVGSSplatShadowMethod::Mixed"))
+	bool bSelfShadow = false;
+
+	/**
+	 * The size of a texel of the splats' shadow map, which covers every casting actor (up to
+	 * 1024 texels per spatial side, coarser beyond). The grid has 64 depth bins. Smaller spatial
+	 * texels cost more memory and fill; at 512 spatial texels its main resources use about 101 MiB.
+	 */
+	UPROPERTY(config, EditAnywhere, Category = "Shadows",
+		meta = (DisplayName = "Shadow Texel Size", Units = "cm", ClampMin = "0.05", UIMin = "0.25", UIMax = "2.0",
+			EditCondition = "ShadowMethod == EVGSSplatShadowMethod::SplatShadowMap || ShadowMethod == EVGSSplatShadowMethod::Mixed"))
+	float ShadowTexelSize = 0.5f;
+
+	/** The penumbra, as a multiple of what the light's Source Angle gives: 0 is a hard edge. */
+	UPROPERTY(config, EditAnywhere, Category = "Shadows",
+		meta = (DisplayName = "Shadow Softness", ClampMin = "0.0", UIMax = "4.0",
+			EditCondition = "ShadowMethod == EVGSSplatShadowMethod::SplatShadowMap || ShadowMethod == EVGSSplatShadowMethod::Mixed"))
+	float ShadowSoftness = 1.0f;
+
+	/**
+	 * How far behind the splats a surface must be to be shadowed. Raise it if the ground right
+	 * under an actor shows dark specks; lower it if the shadow does not reach the feet.
+	 */
+	UPROPERTY(config, EditAnywhere, Category = "Shadows", AdvancedDisplay,
+		meta = (DisplayName = "Shadow Bias", Units = "cm", ClampMin = "0.0", UIMax = "20.0",
+			EditCondition = "ShadowMethod == EVGSSplatShadowMethod::SplatShadowMap || ShadowMethod == EVGSSplatShadowMethod::Mixed"))
+	float ShadowBias = 3.0f;
+
+	virtual FName GetCategoryName() const override { return TEXT("Plugins"); }
+	virtual void PostInitProperties() override;
+#if WITH_EDITOR
+	virtual FText GetSectionText() const override;
+	virtual FText GetSectionDescription() const override;
+	virtual void PostEditChangeProperty(FPropertyChangedEvent& PropertyChangedEvent) override;
+#endif
+
+private:
+	/** Sets the console variables (as project settings: the console still overrides them). */
+	void ApplyToConsoleVariables() const;
+};
diff -ruN a/VGS/Source/VGSSplatRenderer/Private/VGSSplatShadowLightFunction.cpp b/VGS/Source/VGSSplatRenderer/Private/VGSSplatShadowLightFunction.cpp
--- /dev/null
+++ b/VGS/Source/VGSSplatRenderer/Private/VGSSplatShadowLightFunction.cpp
@@ -0,0 +1,129 @@
+// VGS: binds a depth-aware visibility function to the sun's render proxy. The light
+// component and its saved material are never changed. Existing user functions are kept.
+#include "VGSSplatSubsystem.h"
+#include "VGSSplatShadowVertexFactory.h"
+#include "Components/DirectionalLightComponent.h"
+#include "Components/PrimitiveComponent.h"
+#include "Engine/TextureRenderTarget2D.h"
+#include "Engine/World.h"
+#include "LightSceneProxy.h"
+#include "Materials/MaterialInstanceDynamic.h"
+#include "SceneView.h"
+#include "UObject/ConstructorHelpers.h"
+#include "UObject/UObjectIterator.h"
+
+namespace
+{
+	const TCHAR* ShadowSlot() { return FCString::Strcmp(VGSSPLAT_PLUGIN_NAME, TEXT("VGS")) == 0 ? TEXT("A") : TEXT("B"); }
+	FName ShadowParameter(const TCHAR* Base) { return FName(*(FString(Base) + ShadowSlot())); }
+}
+
+UVGSSplatSubsystem::UVGSSplatSubsystem()
+{
+	const FString Path = FString::Printf(TEXT("/%s/Materials/M_SplatShadowLightFunction.M_SplatShadowLightFunction"), VGSSPLAT_PLUGIN_NAME);
+	ConstructorHelpers::FObjectFinderOptional<UMaterialInterface> Material(*Path);
+	ShadowMaterial = Material.Get();
+}
+
+void UVGSSplatSubsystem::ReleaseShadowLightFunction()
+{
+	if (ShadowInstance) ShadowInstance->SetScalarParameterValue(ShadowParameter(TEXT("Enabled")), 0.0f);
+	const TCHAR* Other = FCString::Strcmp(ShadowSlot(), TEXT("A")) == 0 ? TEXT("EnabledB") : TEXT("EnabledA");
+	if (UDirectionalLightComponent* Light = ShadowLight.Get())
+	{
+		if (Light->SceneProxy && (!ShadowInstance || ShadowInstance->K2_GetScalarParameterValue(Other) < 0.5f))
+			Light->SceneProxy->SetLightFunctionMaterial_GameThread(Light);
+	}
+	ShadowLight.Reset();
+}
+
+VGSSplat::FDeepShadowFrame UVGSSplatSubsystem::UpdateShadowLightFunction(const FSceneViewFamily& Family)
+{
+	VGSSplat::FDeepShadowFrame Frame;
+	const IConsoleVariable* Enabled = IConsoleManager::Get().FindConsoleVariable(TEXT("r.VGSSplat"));
+	if ((Enabled && Enabled->GetInt() == 0) || !VGSSplat::UsesSplatShadowMap() || !ShadowMaterial || !Family.RenderTarget || !Family.EngineShowFlags.LightFunctions)
+	{
+		ReleaseShadowLightFunction();
+		return Frame;
+	}
+	UDirectionalLightComponent* Main = nullptr;
+	float Brightest = -1.0f;
+	for (TObjectIterator<UDirectionalLightComponent> It; It; ++It)
+	{
+		UDirectionalLightComponent* Light = *It;
+		if (Light->GetWorld() != GetWorld() || !Light->IsRegistered() || !Light->IsVisible() ||
+			!Light->CastsDynamicShadow() || !Light->SceneProxy) continue;
+		if (Light->bAtmosphereSunLight && Light->AtmosphereSunLightIndex == 0) { Main = Light; break; }
+		const float Value = Light->Intensity * Light->GetLightColor().GetLuminance();
+		if (Value > Brightest) { Main = Light; Brightest = Value; }
+	}
+	if (Main != ShadowLight.Get()) ReleaseShadowLightFunction();
+	if (!Main || Main->LightFunctionMaterial) { ReleaseShadowLightFunction(); return Frame; }
+	FBox Bounds(ForceInit);
+	const FName ComponentClass(VGSSPLAT_PLUGIN_NAME == FString(TEXT("VGS")) ? TEXT("VGSCaptureComponent") : TEXT("VGSStaticSplatComponent"));
+	for (TObjectIterator<UPrimitiveComponent> It; It; ++It)
+	{
+		if (It->GetWorld() != GetWorld() || !It->IsRegistered() || !It->IsVisible() || !It->CastShadow) continue;
+		for (const UClass* Class = It->GetClass(); Class; Class = Class->GetSuperClass())
+			if (Class->GetFName() == ComponentClass) { Bounds += It->Bounds.GetBox(); break; }
+	}
+	if (!Bounds.IsValid) { ReleaseShadowLightFunction(); return Frame; }
+	Frame.Z = Main->GetForwardVector().GetSafeNormal();
+	Frame.Z.FindBestAxisVectors(Frame.X, Frame.Y);
+	Frame.Origin = Bounds.GetCenter();
+	Frame.Extent = FVector::ZeroVector;
+	for (int32 Corner = 0; Corner < 8; ++Corner)
+	{
+		const FVector P((Corner & 1) ? Bounds.Max.X : Bounds.Min.X, (Corner & 2) ? Bounds.Max.Y : Bounds.Min.Y, (Corner & 4) ? Bounds.Max.Z : Bounds.Min.Z);
+		const FVector D = P - Frame.Origin;
+		Frame.Extent.X = FMath::Max(Frame.Extent.X, FMath::Abs(FVector::DotProduct(D, Frame.X)));
+		Frame.Extent.Y = FMath::Max(Frame.Extent.Y, FMath::Abs(FVector::DotProduct(D, Frame.Y)));
+		Frame.Extent.Z = FMath::Max(Frame.Extent.Z, FMath::Abs(FVector::DotProduct(D, Frame.Z)));
+	}
+	Frame.Extent = Frame.Extent * 1.1 + FVector(10.0);
+	const auto CVar = [](const TCHAR* Name, float Default) { const IConsoleVariable* V = IConsoleManager::Get().FindConsoleVariable(Name); return V ? V->GetFloat() : Default; };
+	const float Texel = FMath::Max(CVar(TEXT("r.VGSSplat.Shadow.TexelSize"), 0.5f), 0.05f);
+	const int32 Limit = FMath::Clamp(int32(CVar(TEXT("r.VGSSplat.Shadow.MaxMapSize"), 1024)), 64, 1024);
+	Frame.Resolution = FMath::Clamp(Align(FMath::CeilToInt(2.0 * FMath::Max(Frame.Extent.X, Frame.Extent.Y) / Texel), 64), 64, Limit);
+	const auto Ensure = [this](TObjectPtr<UTextureRenderTarget2D>& Texture, FIntPoint Size, EPixelFormat Format)
+	{
+		if (!Texture || Texture->SizeX != Size.X || Texture->SizeY != Size.Y)
+		{
+			Texture = NewObject<UTextureRenderTarget2D>(this);
+			Texture->bCanCreateUAV = true;
+			Texture->ClearColor = FLinearColor::Black;
+			Texture->InitCustomFormat(Size.X, Size.Y, Format, true);
+			Texture->UpdateResourceImmediate(true);
+		}
+	};
+	Ensure(ShadowAtlas, FIntPoint(Frame.Resolution * 8, Frame.Resolution * 9), PF_R16F);
+	Ensure(ShadowReceivers, Family.RenderTarget->GetSizeXY(), PF_R32_FLOAT);
+	if (!ShadowInstance)
+	{
+		// Both plugins share one visibility function, with independent grids in slots A/B.
+		// Finding the MID by its world-local name avoids a link dependency between plugins.
+		ShadowInstance = FindObject<UMaterialInstanceDynamic>(GetWorld(), TEXT("VGSShadowLightVisibility"));
+		if (!ShadowInstance) ShadowInstance = UMaterialInstanceDynamic::Create(ShadowMaterial, GetWorld(), TEXT("VGSShadowLightVisibility"));
+	}
+	if (!ParameterSource)
+	{
+		ParameterSource = NewObject<UDirectionalLightComponent>(this);
+		ParameterSource->LightFunctionMaterial = ShadowInstance;
+	}
+	ShadowInstance->SetTextureParameterValue(ShadowParameter(TEXT("ShadowAtlas")), ShadowAtlas);
+	ShadowInstance->SetTextureParameterValue(ShadowParameter(TEXT("CaptureMask")), ShadowReceivers);
+	const auto Vector = [this](const TCHAR* Name, const FVector& V) { ShadowInstance->SetVectorParameterValue(ShadowParameter(Name), FLinearColor(float(V.X), float(V.Y), float(V.Z), 0)); };
+	Vector(TEXT("GridOrigin"), Frame.Origin);
+	Vector(TEXT("GridX"), Frame.X); Vector(TEXT("GridY"), Frame.Y); Vector(TEXT("GridZ"), Frame.Z);
+	Vector(TEXT("GridExtent"), Frame.Extent);
+	ShadowInstance->SetScalarParameterValue(ShadowParameter(TEXT("GridResolution")), float(Frame.Resolution));
+	ShadowInstance->SetScalarParameterValue(ShadowParameter(TEXT("DepthBias")), FMath::Max(CVar(TEXT("r.VGSSplat.Shadow.Bias"), 3), 0.0f));
+	ShadowInstance->SetScalarParameterValue(ShadowParameter(TEXT("SelfShadow")), CVar(TEXT("r.VGSSplat.Shadow.Self"), 0));
+	ShadowInstance->SetScalarParameterValue(ShadowParameter(TEXT("Penumbra")), FMath::Tan(FMath::DegreesToRadians(Main->LightSourceAngle * 0.5f)) * CVar(TEXT("r.VGSSplat.Shadow.Softness"), 1));
+	ShadowInstance->SetScalarParameterValue(ShadowParameter(TEXT("Enabled")), 1.0f);
+	Main->SceneProxy->SetLightFunctionMaterial_GameThread(ParameterSource);
+	ShadowLight = Main;
+	Frame.Atlas = ShadowAtlas->GameThread_GetRenderTargetResource();
+	Frame.Receivers = ShadowReceivers->GameThread_GetRenderTargetResource();
+	return Frame;
+}
diff -ruN a/VGS/Source/VGSSplatRenderer/Private/VGSSplatShadowVertexFactory.cpp b/VGS/Source/VGSSplatRenderer/Private/VGSSplatShadowVertexFactory.cpp
--- /dev/null
+++ b/VGS/Source/VGSSplatRenderer/Private/VGSSplatShadowVertexFactory.cpp
@@ -0,0 +1,274 @@
+// VGS: not Epic's. See VGSSplatShadowVertexFactory.h.
+#include "VGSSplatShadowVertexFactory.h"
+
+#include "DataDrivenShaderPlatformInfo.h"
+#include "Materials/Material.h"
+#include "Materials/MaterialRenderProxy.h"
+#include "MaterialDomain.h"
+#include "MeshDrawShaderBindings.h"
+#include "MeshMaterialShader.h"
+#include "PrimitiveSceneProxy.h"
+#include "RenderUtils.h"
+#include "RHIResourceUtils.h"
+#include "Runtime/Launch/Resources/Version.h"
+#include "SceneManagement.h"
+#include "SceneInterface.h"
+#include "SceneView.h"
+#include "VGSSplatLightShadow.h"
+#include "LightSceneInfo.h"
+#include "LightSceneProxy.h"
+
+IMPLEMENT_GLOBAL_SHADER_PARAMETER_STRUCT(FVGSSplatShadowParameters, "VGSSplatShadow");
+
+static TAutoConsoleVariable<int32> CVarVGSSplatShadowMethod(
+	TEXT("r.VGSSplat.Shadow.Method"),
+	0,
+	TEXT("How splats cast shadows (the project's settings set it).\n")
+	TEXT("0: depth-resolved splat shadow map applied by the main light's Light Function (default). Native fallback if unavailable.\n")
+	TEXT("1: that for the main directional light, and Unreal's shadow maps (as 2) for every other light.\n")
+	TEXT("2: in Unreal's shadow maps, for every light: each splat an opaque octahedron where its opacity reaches a cutoff of its own, drawn at random.\n")
+	TEXT("3: none."),
+	ECVF_RenderThreadSafe);
+
+VGSSplat::EShadowMethod VGSSplat::GetShadowMethod()
+{
+	return EShadowMethod(FMath::Clamp(CVarVGSSplatShadowMethod.GetValueOnAnyThread(), 0, 3));
+}
+
+namespace
+{
+	/**
+	 * The index buffer every draw shares: SplatsPerDraw octahedra of six vertices (vertex
+	 * 2a + s is the end of axis a, s 0 the + end and 1 the - end) and eight faces, one per
+	 * octant, wound outwards for a right-handed frame of axes.
+	 */
+	class FVGSSplatShadowIndexBuffer : public FIndexBuffer
+	{
+	public:
+		virtual void InitRHI(FRHICommandListBase& RHICmdList) override
+		{
+			TArray<uint16> Indices;
+			Indices.Reserve(FVGSSplatShadowVertexFactory::SplatsPerDraw * 24);
+			for (uint32 Splat = 0; Splat < FVGSSplatShadowVertexFactory::SplatsPerDraw; ++Splat)
+			{
+				const uint32 Base = Splat * 6;
+				for (uint32 Octant = 0; Octant < 8; ++Octant)
+				{
+					const uint32 SX = Octant & 1, SY = (Octant >> 1) & 1, SZ = (Octant >> 2) & 1;
+					const uint16 A = uint16(Base + 0 + SX), B = uint16(Base + 2 + SY), C = uint16(Base + 4 + SZ);
+					// (+x, +y, +z) wound A B C faces outwards; each axis flipped mirrors it.
+					if (((SX + SY + SZ) & 1) == 0)
+					{
+						Indices.Append({ A, B, C });
+					}
+					else
+					{
+						Indices.Append({ A, C, B });
+					}
+				}
+			}
+			IndexBufferRHI = UE::RHIResourceUtils::CreateIndexBufferFromArray(RHICmdList, TEXT("VGSSplatShadow.Indices"), EBufferUsageFlags::Static, MakeConstArrayView(Indices));
+		}
+	};
+	TGlobalResource<FVGSSplatShadowIndexBuffer> GVGSSplatShadowIndexBuffer;
+
+	/** Bound as the normals when there are none: one zero word. */
+	class FVGSSplatShadowNoNormals : public FRenderResource
+	{
+	public:
+		FBufferRHIRef Buffer;
+		FShaderResourceViewRHIRef SRV;
+
+		virtual void InitRHI(FRHICommandListBase& RHICmdList) override
+		{
+			const uint32 Zero[4] = {};
+			Buffer = UE::RHIResourceUtils::CreateBufferFromArray(RHICmdList, TEXT("VGSSplatShadow.NoNormals"),
+				EBufferUsageFlags::Static | EBufferUsageFlags::StructuredBuffer | EBufferUsageFlags::ShaderResource, sizeof(uint32), Zero, sizeof(Zero));
+			SRV = RHICmdList.CreateShaderResourceView(Buffer, FRHIViewDesc::CreateBufferSRV().SetTypeFromBuffer(Buffer));
+		}
+		virtual void ReleaseRHI() override
+		{
+			SRV.SafeRelease();
+			Buffer.SafeRelease();
+		}
+	};
+	TGlobalResource<FVGSSplatShadowNoNormals> GVGSSplatShadowNoNormals;
+}
+
+/** Binds the parameters, and where each draw's batch of splats starts. */
+class FVGSSplatShadowVertexFactoryShaderParameters : public FVertexFactoryShaderParameters
+{
+	DECLARE_TYPE_LAYOUT(FVGSSplatShadowVertexFactoryShaderParameters, NonVirtual);
+
+public:
+	void Bind(const FShaderParameterMap& ParameterMap)
+	{
+		FirstSplat.Bind(ParameterMap, TEXT("VGSShadowFirstSplat"));
+	}
+
+	void GetElementShaderBindings(
+		const FSceneInterface* Scene,
+		const FSceneView* View,
+		const FMeshMaterialShader* Shader,
+		const EVertexInputStreamType InputStreamType,
+		ERHIFeatureLevel::Type FeatureLevel,
+		const FVertexFactory* InVertexFactory,
+		const FMeshBatchElement& BatchElement,
+		FMeshDrawSingleShaderBindings& ShaderBindings,
+		FVertexInputStreamArray& VertexStreams) const
+	{
+		const FVGSSplatShadowVertexFactory* VertexFactory = static_cast<const FVGSSplatShadowVertexFactory*>(InVertexFactory);
+		ShaderBindings.Add(Shader->GetUniformBufferParameter<FVGSSplatShadowParameters>(), VertexFactory->UniformBuffer);
+		ShaderBindings.Add(FirstSplat, uint32(BatchElement.UserIndex));
+	}
+
+private:
+	LAYOUT_FIELD(FShaderParameter, FirstSplat);
+};
+
+IMPLEMENT_TYPE_LAYOUT(FVGSSplatShadowVertexFactoryShaderParameters);
+IMPLEMENT_VERTEX_FACTORY_PARAMETER_TYPE(FVGSSplatShadowVertexFactory, SF_Vertex, FVGSSplatShadowVertexFactoryShaderParameters);
+
+FVGSSplatShadowVertexFactory::FVGSSplatShadowVertexFactory(ERHIFeatureLevel::Type InFeatureLevel)
+	: FVertexFactory(InFeatureLevel)
+{
+}
+
+void FVGSSplatShadowVertexFactory::InitRHI(FRHICommandListBase& RHICmdList)
+{
+	// No vertex data: everything is read from the splat buffer by vertex index. Only the
+	// stream of GPU Scene instance ids, which the engine supplies.
+	FVertexStream NullStream;
+	NullStream.VertexBuffer = nullptr;
+	NullStream.Stride = 0;
+	NullStream.Offset = 0;
+	NullStream.VertexStreamUsage = EVertexStreamUsage::ManualFetch;
+	check(Streams.Num() == 0);
+	Streams.Add(NullStream);
+
+	FVertexDeclarationElementList Elements;
+#if ENGINE_MAJOR_VERSION > 5 || ENGINE_MINOR_VERSION >= 9
+	AddPrimitiveIdStreamElement(EVertexInputStreamType::Default, Elements, 13);
+#else
+	AddPrimitiveIdStreamElement(EVertexInputStreamType::Default, Elements, 13, 13);
+#endif
+	InitDeclaration(Elements);
+}
+
+void FVGSSplatShadowVertexFactory::ReleaseRHI()
+{
+	UniformBuffer.SafeRelease();
+	FVertexFactory::ReleaseRHI();
+}
+
+bool FVGSSplatShadowVertexFactory::ShouldCompilePermutation(const FVertexFactoryShaderPermutationParameters& Parameters)
+{
+	// Drawn with the default material only, on desktop shader models.
+	return Parameters.MaterialParameters.bIsSpecialEngineMaterial
+		&& Parameters.MaterialParameters.MaterialDomain == MD_Surface
+		&& IsFeatureLevelSupported(Parameters.Platform, ERHIFeatureLevel::SM5)
+		&& IsPCPlatform(Parameters.Platform);
+}
+
+void FVGSSplatShadowVertexFactory::ModifyCompilationEnvironment(const FVertexFactoryShaderPermutationParameters& Parameters, FShaderCompilerEnvironment& OutEnvironment)
+{
+	FVertexFactory::ModifyCompilationEnvironment(Parameters, OutEnvironment);
+#if ENGINE_MAJOR_VERSION > 5 || ENGINE_MINOR_VERSION >= 9
+	const bool bSceneData = Parameters.VertexFactoryType->SupportsGPUScene(GetMaxSupportedFeatureLevel(Parameters.Platform));
+#else
+	const bool bSceneData = Parameters.VertexFactoryType->SupportsPrimitiveIdStream() && UseGPUScene(Parameters.Platform);
+#endif
+	OutEnvironment.SetDefine(TEXT("VF_SUPPORTS_PRIMITIVE_SCENE_DATA"), bSceneData);
+}
+
+void FVGSSplatShadowVertexFactory::SetParameters(FRHICommandListBase& RHICmdList, const FVGSSplatShadowParameters& Parameters)
+{
+	NumSplats = Parameters.NumSplats;
+	FVGSSplatShadowParameters Bound = Parameters;
+	if (!Bound.Normals)
+	{
+		Bound.Normals = GVGSSplatShadowNoNormals.SRV;
+		Bound.HasNormals = 0;
+	}
+	if (UniformBuffer.IsValid())
+	{
+		// In place, in order with the commands already recorded: draws of earlier frames keep
+		// what they were given, and a capture that plays changes this every frame.
+		UniformBuffer.UpdateUniformBufferImmediate(RHICmdList, Bound);
+	}
+	else
+	{
+		UniformBuffer = TUniformBufferRef<FVGSSplatShadowParameters>::CreateUniformBufferImmediate(Bound, UniformBuffer_MultiFrame);
+	}
+}
+
+void FVGSSplatShadowVertexFactory::ClearSplats()
+{
+	NumSplats = 0;
+}
+
+void FVGSSplatShadowVertexFactory::AddShadowMeshes(const FPrimitiveSceneProxy& Proxy, const FSceneView& View, int32 ViewIndex, FMeshElementCollector& Collector, bool bReverseCulling) const
+{
+	const VGSSplat::EShadowMethod Method = VGSSplat::GetShadowMethod();
+	const IConsoleVariable* Enabled = IConsoleManager::Get().FindConsoleVariable(TEXT("r.VGSSplat"));
+	if ((Enabled && Enabled->GetInt() == 0) || !HasParameters() || Method == VGSSplat::EShadowMethod::None)
+	{
+		return;
+	}
+	if (Method != VGSSplat::EShadowMethod::UnrealShadowMaps && View.Family && View.Family->Scene && View.Family->Scene->GetRenderScene())
+	{
+		// A shadow depth view looks along its light (FProjectedShadowInfo::ModifyViewForShadow
+		// turns it so, for billboards): the main directional light's views are the ones looking
+		// along its direction, which the splats' own shadow map covers.
+		const FLightSceneInfo* MainLight = VGSSplat::FindMainLight(*View.Family->Scene->GetRenderScene());
+		const FMaterialRenderProxy* Function = MainLight ? MainLight->Proxy->GetLightFunctionMaterial() : nullptr;
+		const bool bOwnFunction = Function && Function->GetMaterialName().StartsWith(TEXT("VGSShadowLightVisibility"));
+		if (bOwnFunction && (Method == VGSSplat::EShadowMethod::SplatShadowMap ||
+			FMath::Abs(FVector::DotProduct(View.GetViewDirection(), VGSSplat::GetMainLightDirection(*MainLight))) > 0.99999))
+		{
+			return;
+		}
+		// A user light function, disabled light functions, or a missing resource uses native
+		// casters instead. Never overwrite the user's material or silently lose the shadow.
+	}
+	const FMaterialRenderProxy* Material = UMaterial::GetDefaultMaterial(MD_Surface)->GetRenderProxy();
+	for (uint32 First = 0; First < NumSplats; First += SplatsPerDraw)
+	{
+		const uint32 Count = FMath::Min(SplatsPerDraw, NumSplats - First);
+		FMeshBatch& Mesh = Collector.AllocateMesh();
+		Mesh.VertexFactory = this;
+		Mesh.MaterialRenderProxy = Material;
+		Mesh.Type = PT_TriangleList;
+		Mesh.CastShadow = true;
+		Mesh.bUseAsOccluder = false;
+		Mesh.bUseForDepthPass = false;
+		Mesh.bUseForMaterial = false; // shadows only: the splat renderer draws them in the view
+		Mesh.ReverseCulling = bReverseCulling;
+		Mesh.bCanApplyViewModeOverrides = false;
+		Mesh.DepthPriorityGroup = SDPG_World;
+
+		FMeshBatchElement& Element = Mesh.Elements[0];
+		Element.IndexBuffer = &GVGSSplatShadowIndexBuffer;
+		Element.FirstIndex = 0;
+		Element.NumPrimitives = Count * 8;
+		Element.MinVertexIndex = 0;
+		Element.MaxVertexIndex = Count * 6 - 1;
+		Element.NumInstances = 1;
+		Element.UserIndex = int32(First);
+		Element.PrimitiveUniformBuffer = Proxy.GetUniformBuffer();
+		Collector.AddMesh(ViewIndex, Mesh);
+	}
+}
+
+// GPU Scene, so that virtual shadow maps draw the splats (they take only such vertex factories).
+#if ENGINE_MAJOR_VERSION > 5 || ENGINE_MINOR_VERSION >= 9

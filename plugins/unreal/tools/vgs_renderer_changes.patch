+			const float SafeOpacity = max(Opacity, 1e-3f);
+			const float3 ColorSRGB = VGSLinearToSRGB(saturate(WorkingColorSpaceColorToSRGB(Color / SafeOpacity)));
+			Color = SRGBColorToWorkingColorSpace(VGSSRGBToLinear(VGSApplyGrade(ColorSRGB, Opacity))) * SafeOpacity;
+		}
+#if APPLY_INVERSE_TONE_CURVE
+		const float3 InversedSRGB = SampleInverseToneCurveLUT(saturate(WorkingColorSpaceColorToSRGB(Color)), InverseToneCurveLUTEdge);
+		Blended = lerp(Color, SRGBColorToWorkingColorSpace(InversedSRGB), Strength);
+#else
+		Blended = Color;
+#endif

IDI_APP_ICON ICON DISCARDABLE "@VGS_EDITOR_DIR@/assets/gracia/logo.ico"

// The version comes from viewerversion.h, read by CMakeLists.txt.
1 VERSIONINFO
FILEVERSION @VGS_VIEWER_VERSION_COMMAS@
PRODUCTVERSION @VGS_VIEWER_VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Victor M. Feliz"
            VALUE "FileDescription", "VGS Viewer"
            VALUE "FileVersion", "@VGS_VIEWER_VERSION@.0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Victor M. Feliz. All rights reserved."
            VALUE "OriginalFilename", "VGSViewer.exe"
            VALUE "ProductName", "VGS Viewer"
            VALUE "ProductVersion", "@VGS_VIEWER_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDI_APP_ICON ICON DISCARDABLE "@CMAKE_CURRENT_SOURCE_DIR@/assets/gracia/logo.ico"

// The version comes from licensemanagement.h (CMakeLists.txt reads it).
1 VERSIONINFO
FILEVERSION @VGS_EDITOR_VERSION_COMMAS@
PRODUCTVERSION @VGS_EDITOR_VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Victor M. Feliz"
            VALUE "FileDescription", "VGS Editor"
            VALUE "FileVersion", "@VGS_EDITOR_VERSION@.0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Victor M. Feliz. All rights reserved."
            VALUE "OriginalFilename", "VGSEditor.exe"
            VALUE "ProductName", "VGS Editor"
            VALUE "ProductVersion", "@VGS_EDITOR_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

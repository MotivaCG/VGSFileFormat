if(NOT TARGET VGS::Pcodec)
  add_library(VGS::Pcodec STATIC IMPORTED)
  get_filename_component(_vgs_libdir "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
  set_target_properties(VGS::Pcodec PROPERTIES IMPORTED_LOCATION
      "${_vgs_libdir}/@CMAKE_STATIC_LIBRARY_PREFIX@vgs_pcodec@CMAKE_STATIC_LIBRARY_SUFFIX@")
  if(WIN32)
    set_property(TARGET VGS::Pcodec PROPERTY INTERFACE_LINK_LIBRARIES userenv ws2_32 bcrypt ntdll)
  else()
    include(CMakeFindDependencyMacro)
    find_dependency(Threads)
    set_property(TARGET VGS::Pcodec PROPERTY INTERFACE_LINK_LIBRARIES "Threads::Threads;${CMAKE_DL_LIBS};m")
  endif()
endif()
